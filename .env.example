# ============================================================================
#  zo2api  ──  .env.example
# ----------------------------------------------------------------------------
#  Copy this file to `.env` (install.sh / install.ps1 do it automatically)
#  and fill in the providers you actually want to enable. Empty values mean
#  the provider is disabled; zo2api will fall back to the Zo backend when
#  ZO_CLIENT_IDENTITY_TOKEN is set.
# ============================================================================

# ============================================================================
#  代理自身  ─ Proxy itself
# ============================================================================
# 留空首次启动时自动生成 sk-ant-proxy-<24hex>，打印到 stdout 一次后丢失。
# 强烈建议由 install 脚本预生成并固化在此处。
PROXY_API_KEY=

# 宿主侧端口（容器内固定 3000）
HOST_PORT=3000

# ============================================================================
#  Provider: Anthropic
# ============================================================================
ANTHROPIC_API_KEY=
# 自托管 / 代理可改，留空走官方 https://api.anthropic.com/v1
ANTHROPIC_BASE_URL=

# ============================================================================
#  Provider: OpenAI
# ============================================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT=

# ============================================================================
#  Provider: OpenRouter
# ============================================================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# ============================================================================
#  Provider: Google Gemini
# ============================================================================
GEMINI_API_KEY=
GEMINI_BASE_URL=

# ============================================================================
#  Provider: Zo  ─ universal fallback when other providers have no key
# ============================================================================
ZO_API_BASE_URL=
# 任意一个非空都行，按优先级取：CLIENT_IDENTITY_TOKEN > ACCESS_TOKEN > API_KEY
ZO_CLIENT_IDENTITY_TOKEN=
ZO_ACCESS_TOKEN=
ZO_API_KEY=
# 仅用于 banner 显示组织名
ZO_USER=

# ============================================================================
#  行为开关  ─ Behavior switches
# ============================================================================
# 关闭可去掉 4xx body capture 与异步 debug 日志（=0 关闭，其他值开启）
DEBUG_LOG_ENABLED=1

# 上游请求超时 (ms)
FETCH_TIMEOUT_MS=120000

# 请求体最大字节数（默认 10MB）
MAX_BODY_BYTES=10485760

# 启动 banner 用，影响打印的 base URL
PUBLIC_DOMAIN=
ANTHROPIC_ORG_ID=
